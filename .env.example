# ============================================================
# RENOWA — variáveis de ambiente (exemplo)
# Copie para .env e preencha os valores reais
# ============================================================

# ----- Backend -----
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:senha@ip:porta/banco

# Auth nativa — access token web (JWT HS256, 15 min, cookie renowa_at)
RENOWA_AT_SECRET=troque-por-segredo-forte-256-bits

# Segredo para sessões mobile (JWT HS256, 30 dias)
RENOWA_JWT_SECRET=change-me-to-a-strong-random-secret-256-bits

# ----- Frontend -----
VITE_API_URL=http://localhost:3000/api

# ----- Mobile -----
EXPO_PUBLIC_API_URL=http://localhost:3000/api
