# ============================================================
# RENOWA — variáveis de ambiente (exemplo)
# Copie para .env e preencha os valores reais
# ============================================================

# ----- Backend -----
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:senha@ip:porta/banco

# ZonaDevAuth — JWKS para validação RS256
ZONADEV_JWKS_URL=https://auth.zonadev.tech/.well-known/jwks.json
ZONADEV_EXPECTED_ISS=auth.zonadev.tech
ZONADEV_EXPECTED_AUD=renowa.zonadev.tech

# Segredo para sessões mobile (JWT HS256, 30 dias)
RENOWA_JWT_SECRET=change-me-to-a-strong-random-secret-256-bits

# ----- Frontend -----
VITE_API_URL=http://localhost:3000/api

# ----- Mobile -----
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_AUTH_URL=https://auth.zonadev.tech
